<!--
    CustomMenu : 1차 메뉴(좌측 세로 / 상단 가로).
    WHY: 메뉴 버튼은 ItemsSource 바인딩 없이 코드비하인드(SetItems)에서 직접 만든다 → 디버거로 추적 가능.
         버튼 색은 DynamicResource 키(sh.Menu.*)로 참조하고, 코드비하인드가 DP 값을 이 키에 써 넣는다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않는다. 그래서 색 리소스(sh.*)의 기본값과
         자리표시 항목(홈 / Menu1 ~ Menu4)을 XAML에 직접 두었다. 런타임에는 생성자가 자리표시 항목을 지우고 색 리소스를 속성값으로 덮어쓴다.
-->
<UserControl x:Class="shComponent.CustomMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignWidth="280" d:DesignHeight="360">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/shComponent;component/Themes/ScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 메뉴 버튼 색/모양. 기본값(디자이너용)이며 런타임에는 코드비하인드(ApplyResources/ApplyOrientation)가 덮어쓴다. -->
            <x:Static x:Key="sh.Menu.Hover" Member="theme:ShPalette.NavHover"/>
            <x:Static x:Key="sh.Menu.Pressed" Member="theme:ShPalette.NavPressed"/>
            <x:Static x:Key="sh.Menu.Selected" Member="theme:ShPalette.NavSelected"/>
            <x:Static x:Key="sh.Menu.Accent" Member="theme:ShPalette.Accent"/>
            <x:Static x:Key="sh.Menu.ItemCornerRadius" Member="theme:ShPalette.ControlCornerRadius"/>
            <Visibility x:Key="sh.Menu.IndicatorV">Visible</Visibility>
            <Visibility x:Key="sh.Menu.IndicatorH">Collapsed</Visibility>

            <ControlTemplate x:Key="NavItemTemplate" TargetType="{x:Type ToggleButton}">
                <Grid Background="Transparent" SnapsToDevicePixels="True">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource sh.Menu.ItemCornerRadius}"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <!-- 세로 메뉴: 왼쪽 세로 막대 / 가로 메뉴: 아래 가로 막대 (Windows 11 선택 표시) -->
                    <Border x:Name="IndicatorV" Width="3" Height="16" CornerRadius="1.5"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource sh.Menu.Accent}" Opacity="0"
                            Visibility="{DynamicResource sh.Menu.IndicatorV}"/>
                    <Border x:Name="IndicatorH" Width="16" Height="3" CornerRadius="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                            Background="{DynamicResource sh.Menu.Accent}" Opacity="0"
                            Visibility="{DynamicResource sh.Menu.IndicatorH}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource sh.Menu.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource sh.Menu.Selected}"/>
                        <Setter TargetName="IndicatorV" Property="Opacity" Value="1"/>
                        <Setter TargetName="IndicatorH" Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource sh.Menu.Pressed}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 디자이너 자리표시 항목 전용 스타일(코드비하인드 CreateItemButton과 같은 값). -->
            <Style x:Key="DesignItemStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Template" Value="{StaticResource NavItemTemplate}"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="8,2,8,2"/>
                <Setter Property="Padding" Value="14,0,12,0"/>
                <Setter Property="Foreground" Value="{x:Static theme:ShPalette.TextPrimary}"/>
                <Setter Property="FontFamily" Value="{x:Static theme:ShPalette.TextFont}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style x:Key="DesignGlyphStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{x:Static theme:ShPalette.IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="DesignTitleStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="14,0,0,1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" Focusable="False"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ItemsHost">
            <!-- 디자이너 자리표시 항목: 런타임에는 생성자가 지운다. -->
            <ToggleButton Style="{StaticResource DesignItemStyle}" IsChecked="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DesignGlyphStyle}" Text="&#xE80F;"/>
                    <TextBlock Style="{StaticResource DesignTitleStyle}" Text="홈"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource DesignItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DesignGlyphStyle}" Text="&#xE7C3;"/>
                    <TextBlock Style="{StaticResource DesignTitleStyle}" Text="Menu1"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource DesignItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DesignGlyphStyle}" Text="&#xE7C3;"/>
                    <TextBlock Style="{StaticResource DesignTitleStyle}" Text="Menu2"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource DesignItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DesignGlyphStyle}" Text="&#xE7C3;"/>
                    <TextBlock Style="{StaticResource DesignTitleStyle}" Text="Menu3"/>
                </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource DesignItemStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DesignGlyphStyle}" Text="&#xE7C3;"/>
                    <TextBlock Style="{StaticResource DesignTitleStyle}" Text="Menu4"/>
                </StackPanel>
            </ToggleButton>
        </StackPanel>
    </ScrollViewer>
</UserControl>
