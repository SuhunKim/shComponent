<!--
    CustomMain : 최상위 프레임. Window 안에 이 컨트롤 하나만 놓으면 Windows 11 설정 앱 구조가 완성된다.

      ┌──────────────┬──────────────────────────────────────┐
      │ ≡  앱 제목   │  페이지 제목 (1차 › 2차)             │
      │              │  [서브메뉴 탭]                       │
      │  CustomMenu  │  ┌────────────────────────────────┐  │
      │              │  │ CustomPanel (페이지/스켈레톤)  │  │
      │              │  └────────────────────────────────┘  │
      └──────────────┴──────────────────────────────────────┘

    책임: 레이아웃 배치 + 메뉴 → 서브메뉴 → 패널 연결(오케스트레이션). 페이지 내용/업무 로직은 모른다.

    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않는다. 코드가 넣는 색/제목/여백은 d: 값(디자이너 전용, 런타임 기본값과 동일)으로
         보여 준다. 안쪽 CustomMenu/SubMenu/Panel은 실제 컨트롤이라 각자의 디자이너 샘플(Menu1, SubMenu1 ...)이 표시된다.
-->
<UserControl x:Class="shComponent.CustomMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Background="{x:Static theme:ShPalette.WindowBackground}"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignWidth="1100" d:DesignHeight="700">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PaneColumn" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 내비게이션 영역 (좌측 또는 상단) -->
        <Border x:Name="PaneHost" Grid.RowSpan="2" d:Background="{x:Static theme:ShPalette.PaneBackground}">
            <DockPanel x:Name="PaneDock" LastChildFill="True">
                <Grid x:Name="PaneHeader" DockPanel.Dock="Top" Height="48" Margin="6,6,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:CustomButton x:Name="PaneToggleButton" Appearance="Subtle" Glyph="&#xE700;" GlyphSize="16"
                                        Width="40" Height="36" MinHeight="0" Padding="0"
                                        ToolTip="메뉴 접기/펼치기" Click="OnPaneToggleClick"/>
                    <TextBlock x:Name="AppGlyphText" Grid.Column="1" FontSize="16" Margin="10,0,0,0"
                               VerticalAlignment="Center" d:Visibility="Collapsed"
                               FontFamily="{x:Static theme:ShPalette.IconFont}"/>
                    <TextBlock x:Name="AppTitleText" Grid.Column="2" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,1"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" d:Text="shComponent"/>
                </Grid>
                <local:CustomMenu x:Name="MainMenu" Margin="0,4,0,8"/>
            </DockPanel>
        </Border>

        <!-- 콘텐츠 영역 -->
        <Border x:Name="ContentHost" Grid.Column="1" Grid.RowSpan="2"
                CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                d:Background="{x:Static theme:ShPalette.ContentBackground}" d:BorderBrush="{x:Static theme:ShPalette.ContentBorder}">
            <Grid x:Name="ContentGrid" d:Margin="36,28,36,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PageTitleText" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"
                           FontWeight="SemiBold" FontFamily="{x:Static theme:ShPalette.DisplayFont}"
                           d:FontSize="28" d:Text="Menu1  ›  SubMenu1"/>
                <local:CustomSubMenu x:Name="SubMenuView" Grid.Row="1" Margin="-12,0,0,16"/>
                <local:CustomPanel x:Name="ContentPanel" Grid.Row="2"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
