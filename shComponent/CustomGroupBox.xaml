<!--
    CustomGroupBox : 제목 + 둥근 컨테이너. Windows 11 설정 앱의 "섹션" 느낌.
    WHY(구조): 디자이너에서 열리도록 x:Class UserControl로 만들었다. 제목(Header)과 안쪽 내용(Content)은 코드비하인드의 별도 속성이며,
         UserControl.Content(=이 XAML의 Grid)와 충돌하지 않도록 Content를 가려(new) 둔다. 사용법은 GroupBox와 같다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않고 기본 UserControl로 그린다.
         그래서 바인딩마다 FallbackValue(= 런타임 기본값, 글자는 GroupBox1)를, 루트에 d:글꼴/색을 두어 디자이너에서도 실제 모양이 보이게 했다.
         런타임에는 부모 컨트롤을 항상 찾으므로 FallbackValue와 d: 값은 쓰이지 않는다.
-->
<UserControl x:Class="shComponent.Internal.CustomGroupBoxView"
             
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignHeight="120" d:DesignWidth="300">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ContentPresenter x:Name="HeaderSite"
                          Content="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue=GroupBox1}"
                          RecognizesAccessKey="True"
                          Margin="{Binding HeaderMargin, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue='2,0,0,8'}"
                          TextElement.FontSize="{Binding HeaderFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue=14}"
                          TextElement.FontWeight="SemiBold"
                          TextElement.Foreground="{Binding HeaderForeground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue={x:Static theme:ShPalette.TextPrimary}}">
            <ContentPresenter.Style>
                <Style TargetType="ContentPresenter">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue=x}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentPresenter.Style>
        </ContentPresenter>
        <Border Grid.Row="1"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue={x:Static theme:ShPalette.CardBackground}}"
                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue={x:Static theme:ShPalette.CardBorder}}"
                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue=1}"
                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue={x:Static theme:ShPalette.OverlayCornerRadius}}"
                Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue=16}">
            <ContentPresenter Content="{Binding (local:CustomGroupBox.Content), RelativeSource={RelativeSource AncestorType={x:Type local:CustomGroupBox}}, FallbackValue=Content1}"/>
        </Border>
    </Grid>
</UserControl>
