<!--
    CustomCard : Windows 11 설정 앱의 "설정 카드".
      [아이콘] [제목 / 설명]                    [Content(토글·콤보 등)] [>]
    Header / Description / Glyph를 모두 비우면 Content가 카드 전체를 채우는 일반 카드 컨테이너가 된다.
    WHY(구조): 디자이너에서 열리도록 x:Class UserControl로 만들었다. 클릭 처리(Click/Command/IsPressed)는 코드비하인드(.xaml.cs)에,
         모양은 이 XAML에 있다. 오른쪽 Content는 UserControl.Content(=이 XAML의 Grid)와 충돌하지 않도록 코드비하인드에서 가려(new) 둔다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않고 기본 UserControl로 그린다.
         그래서 바인딩마다 FallbackValue(= 런타임 기본값, 글자는 Card1)를, 루트에 d:글꼴/색을 두어 디자이너에서도 실제 모양이 보이게 했다.
         런타임에는 부모 컨트롤을 항상 찾으므로 FallbackValue와 d: 값은 쓰이지 않는다.
-->
<UserControl x:Class="shComponent.Internal.CustomCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignHeight="64" d:DesignWidth="480">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border x:Name="Bd"
                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue={x:Static theme:ShPalette.CardBorder}}"
                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=1}"
                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue={x:Static theme:ShPalette.OverlayCornerRadius}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue={x:Static theme:ShPalette.CardBackground}}"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsClickable, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}" Value="True"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}"/>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}" Value="True">
                            <Setter Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue='16,12,16,12'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Icon" Text="{Binding Glyph, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=&#xE7C3;}"
                       FontFamily="{x:Static theme:ShPalette.IconFont}"
                       FontSize="{Binding GlyphSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=20}"
                       VerticalAlignment="Center" Margin="4,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Glyph, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel x:Name="TextHost" Grid.Column="1" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <!-- 제목/설명/아이콘이 모두 없으면 Content가 카드 전체를 채운다(일반 카드 컨테이너 모드). -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Glyph, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ContentPresenter x:Name="HeaderSite" Content="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=Card1}"
                                  TextElement.FontSize="{Binding HeaderFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=14}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>
                <TextBlock x:Name="DescriptionText" Text="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=Description1}"
                           Foreground="{Binding DescriptionForeground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue={x:Static theme:ShPalette.TextSecondary}}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ContentPresenter x:Name="ContentSite" Content="{Binding (local:CustomCard.Content), RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Margin" Value="16,0,0,0"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding (local:CustomCard.Content), RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- 컨테이너 모드: Content가 카드 전체(0~2열)를 채운다. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding Glyph, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}, FallbackValue=x}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>

            <TextBlock x:Name="Chevron" Grid.Column="3" Text="&#xE76C;" FontSize="12"
                       FontFamily="{x:Static theme:ShPalette.IconFont}"
                       Foreground="{x:Static theme:ShPalette.TextSecondary}"
                       VerticalAlignment="Center" Margin="16,0,2,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsClickable, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}" Value="True"/>
                                    <Condition Binding="{Binding ShowChevron, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCard}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
