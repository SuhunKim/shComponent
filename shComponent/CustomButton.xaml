<!--
    CustomButton : Windows 11 톤의 둥근 버튼.
    WHY(구조): 디자이너에서 열리도록 x:Class UserControl로 만들고, 안에 진짜 Button 하나를 넣어(래핑) Click / Command / IsDefault 같은
         Button 고유 동작은 그대로 쓴다. 겉 UserControl의 속성(Appearance, CornerRadius, Content ...)이 안쪽 Button과 템플릿에 바인딩된다.
    사용자가 쓰는 Content는 UserControl.Content(=안쪽 Button)와 충돌하므로 코드비하인드에서 Content를 별도 속성으로 가린다(new).
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않고 기본 UserControl로 그린다.
         그래서 바인딩마다 FallbackValue(= 런타임 기본값, 글자는 Button1)를, 루트에 d:글꼴/색을 두어 디자이너에서도 실제 모양이 보이게 했다.
         런타임에는 부모 컨트롤을 항상 찾으므로 FallbackValue와 d: 값은 쓰이지 않는다.
-->
<UserControl x:Class="shComponent.CustomButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignHeight="32" d:DesignWidth="120">
    <UserControl.Resources>
        <ControlTemplate x:Key="ButtonTemplate" TargetType="{x:Type Button}">
            <Grid x:Name="Root" SnapsToDevicePixels="True">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlCornerRadius}}"/>
                <!-- WHY: Accent 모드의 hover/pressed는 색을 따로 받지 않고 반투명 흰색을 덧씌워 "같은 톤, 조금 밝게"를 만든다. -->
                <Border x:Name="Overlay" Background="Transparent"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlCornerRadius}}"/>
                <StackPanel x:Name="ContentHost"
                            Orientation="Horizontal"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <TextBlock x:Name="Icon"
                               Text="{Binding Glyph, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Null}}"
                               FontFamily="{x:Static theme:ShPalette.IconFont}"
                               FontSize="{Binding GlyphSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue=14}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ContentPresenter x:Name="Presenter" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
                <!-- 아이콘 없음 / 텍스트 없음(아이콘 전용 버튼) 처리 -->
                <DataTrigger Binding="{Binding Glyph, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Null}}" Value="{x:Null}">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter TargetName="Icon" Property="Margin" Value="0"/>
                    <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed"/>
                </Trigger>

                <!-- Standard -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlHover}}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlPressed}}"/>
                    <Setter TargetName="ContentHost" Property="Opacity" Value="0.8"/>
                </Trigger>

                <!-- Accent: 뒤에 선언된 트리거가 우선하므로 Standard hover 색을 덮어쓴다. -->
                <DataTrigger Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}" Value="Accent">
                    <Setter TargetName="Bd" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="ContentHost" Property="TextElement.Foreground" Value="{Binding AccentForeground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.OnAccent}}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}" Value="Accent"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Overlay" Property="Background" Value="#1AFFFFFF"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}" Value="Accent"/>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Overlay" Property="Background" Value="#33FFFFFF"/>
                </MultiDataTrigger>

                <!-- Subtle -->
                <DataTrigger Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}" Value="Subtle">
                    <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}" Value="Subtle"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlHover}}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}" Value="Subtle"/>
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlPressed}}"/>
                </MultiDataTrigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- Style={x:Null}: 기본 Button 테마 스타일(배경/글자색 Setter)이 아래 바인딩·상속 값을 덮어쓰지 않게 끊는다. -->
    <Button x:Name="PART_Button"
            Style="{x:Null}"
            Template="{StaticResource ButtonTemplate}"
            FocusVisualStyle="{x:Static theme:ShFocusVisual.Rounded}"
            Content="{Binding (local:CustomButton.Content), RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue=Button1}"
            Command="{Binding Command, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}"
            CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}}"
            IsDefault="{Binding IsDefault, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue=False}"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlBackground}}"
            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue={x:Static theme:ShPalette.ControlBorder}}"
            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue=1}"
            Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue='14,6,14,6'}"
            HorizontalContentAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue=Center}"
            VerticalContentAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:CustomButton}}, FallbackValue=Center}"/>
</UserControl>
