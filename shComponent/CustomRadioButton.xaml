<!--
    CustomRadioButton : Windows 11 톤의 원형 라디오 버튼.
    WHY(구조): 디자이너에서 열리도록 x:Class UserControl로 만들고, 안에 진짜 RadioButton 하나를 넣어(래핑) GroupName 그룹 해제/키보드 이동 같은
         RadioButton 고유 동작을 그대로 쓴다. 글자(Content)는 UserControl.Content와 충돌하므로 코드비하인드에서 별도 속성으로 가려(new) 둔다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않고 기본 UserControl로 그린다.
         그래서 바인딩마다 FallbackValue(= 런타임 기본값, 글자는 RadioButton1)를, 루트에 d:글꼴/색을 두어 디자이너에서도 실제 모양이 보이게 했다.
         런타임에는 부모 컨트롤을 항상 찾으므로 FallbackValue와 d: 값은 쓰이지 않는다.
-->
<UserControl x:Class="shComponent.CustomRadioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignHeight="32" d:DesignWidth="160">
    <UserControl.Resources>
        <ControlTemplate x:Key="RadioTemplate" TargetType="{x:Type RadioButton}">
            <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- WHY: 20x20 좌표계를 Viewbox로 확대/축소해 CircleSize만 바꿔도 비율이 유지된다. -->
                <Viewbox Width="{Binding CircleSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue=20}"
                         Height="{Binding CircleSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue=20}"
                         VerticalAlignment="Center">
                    <Canvas Width="20" Height="20">
                        <Ellipse x:Name="Outer" Width="20" Height="20"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                        <Ellipse x:Name="Dot" Width="8" Height="8" Canvas.Left="6" Canvas.Top="6"
                                 Fill="{Binding DotBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue={x:Static theme:ShPalette.OnAccent}}"
                                 Visibility="Collapsed"/>
                    </Canvas>
                </Viewbox>
                <ContentPresenter x:Name="Presenter" Grid.Column="1"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Outer" Property="Fill" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue={x:Static theme:ShPalette.ControlHover}}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Outer" Property="Fill" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="Outer" Property="Stroke" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                </Trigger>
                <!-- Windows 11처럼 체크된 상태에서 마우스를 올리면 가운데 점이 살짝 커진다. -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Dot" Property="Width" Value="10"/>
                    <Setter TargetName="Dot" Property="Height" Value="10"/>
                    <Setter TargetName="Dot" Property="Canvas.Left" Value="5"/>
                    <Setter TargetName="Dot" Property="Canvas.Top" Value="5"/>
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Outer" Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <RadioButton x:Name="PART_RadioButton"
                 Style="{x:Null}"
                 Template="{StaticResource RadioTemplate}"
                 FocusVisualStyle="{x:Static theme:ShFocusVisual.Rounded}"
                 Content="{Binding (local:CustomRadioButton.Content), RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue=RadioButton1}"
                 GroupName="{Binding GroupName, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue=''}"
                 IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, Mode=TwoWay, FallbackValue=True}"
                 Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue={x:Static theme:ShPalette.ControlBackground}}"
                 BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue={x:Static theme:ShPalette.ControlStrongBorder}}"
                 Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type local:CustomRadioButton}}, FallbackValue='8,0,0,0'}"/>
</UserControl>
