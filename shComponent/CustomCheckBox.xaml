<!--
    CustomCheckBox : Windows 11 톤의 둥근 사각 체크박스 (IsThreeState 지원).
    WHY(구조): 디자이너에서 열리도록 x:Class UserControl로 만들고, 안에 진짜 CheckBox 하나를 넣어(래핑) IsChecked 토글/키보드/3상태 같은
         CheckBox 고유 동작을 그대로 쓴다. 글자(Content)는 UserControl.Content와 충돌하므로 코드비하인드에서 별도 속성으로 가려(new) 둔다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않고 기본 UserControl로 그린다.
         그래서 바인딩마다 FallbackValue(= 런타임 기본값, 글자는 CheckBox1)를, 루트에 d:글꼴/색을 두어 디자이너에서도 실제 모양이 보이게 했다.
         런타임에는 부모 컨트롤을 항상 찾으므로 FallbackValue와 d: 값은 쓰이지 않는다.
-->
<UserControl x:Class="shComponent.CustomCheckBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignHeight="32" d:DesignWidth="160">
    <UserControl.Resources>
        <ControlTemplate x:Key="CheckBoxTemplate" TargetType="{x:Type CheckBox}">
            <!-- WHY: 투명 배경을 깔아 글자 사이 빈 공간을 눌러도 체크되도록(히트 테스트 영역 확보). -->
            <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="{Binding BoxSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue=20}"
                      Height="{Binding BoxSize, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue=20}"
                      VerticalAlignment="Center">
                    <Border x:Name="Box"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding BoxCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue=4}"/>
                    <!-- WHY: 20x20 좌표로 그린 체크 모양을 Viewbox로 감싸 BoxSize를 바꿔도 비율이 유지되게 한다. -->
                    <Viewbox>
                        <Canvas Width="20" Height="20">
                            <Path x:Name="CheckMark" Visibility="Collapsed"
                                  Data="M 5.5,10.5 L 8.7,13.6 L 14.6,6.6"
                                  Stroke="{Binding CheckGlyphBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.OnAccent}}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Rectangle x:Name="IndeterminateMark" Visibility="Collapsed"
                                       Canvas.Left="5.5" Canvas.Top="9.2" Width="9" Height="1.6" RadiusX="0.8" RadiusY="0.8"
                                       Fill="{Binding CheckGlyphBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.OnAccent}}"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
                <ContentPresenter x:Name="Presenter" Grid.Column="1"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter TargetName="Presenter" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.ControlHover}}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="Box" Property="Background" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="Box" Property="BorderBrush" Value="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.Accent}}"/>
                    <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Box" Property="Opacity" Value="0.88"/>
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Box" Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <CheckBox x:Name="PART_CheckBox"
              Style="{x:Null}"
              Template="{StaticResource CheckBoxTemplate}"
              FocusVisualStyle="{x:Static theme:ShFocusVisual.Rounded}"
              Content="{Binding (local:CustomCheckBox.Content), RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue=CheckBox1}"
              IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, Mode=TwoWay, FallbackValue=True}"
              IsThreeState="{Binding IsThreeState, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue=False}"
              Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.ControlBackground}}"
              BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue={x:Static theme:ShPalette.ControlStrongBorder}}"
              BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue=1}"
              Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type local:CustomCheckBox}}, FallbackValue='8,0,0,0'}"/>
</UserControl>
