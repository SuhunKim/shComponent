<!--
    CustomPanel : 메뉴 화면(페이지)을 표시하는 메인 콘텐츠 패널.
    책임: 페이지 표시 / 로딩 중 스켈레톤 / 오류·안내 메시지 / 전환 애니메이션.
    (메뉴나 페이지 생성 규칙은 모른다 → CustomMain과 IPageFactory의 책임)
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않는다. 그래서 안내 메시지 영역에 d: 값(디자이너 전용)으로
         "콘텐츠 영역" 자리표시를 보여 준다. 런타임에는 d: 값이 무시되고 코드비하인드가 페이지/스켈레톤/메시지를 전환한다.
-->
<UserControl x:Class="shComponent.CustomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignWidth="720" d:DesignHeight="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/shComponent;component/Themes/ScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <!-- 페이지 -->
        <ScrollViewer x:Name="PageScroller" Focusable="False"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </ScrollViewer>

        <!-- 로딩 -->
        <local:CustomSkeleton x:Name="Skeleton" Visibility="Collapsed" IsActive="False" VerticalAlignment="Top"/>

        <!-- 오류 / 안내 -->
        <StackPanel x:Name="MessageHost" Visibility="Collapsed" d:Visibility="Visible" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="MessageGlyph" FontSize="36" HorizontalAlignment="Center" d:Text="&#xE946;"
                       FontFamily="{x:Static theme:ShPalette.IconFont}"
                       Foreground="{x:Static theme:ShPalette.TextSecondary}"/>
            <TextBlock x:Name="MessageTitle" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6" d:Text="콘텐츠 영역"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{x:Static theme:ShPalette.TextPrimary}"/>
            <TextBlock x:Name="MessageBody" TextAlignment="Center" TextWrapping="Wrap" d:Text="CustomMain.PageFactory에 페이지를 등록하면 이곳에 표시됩니다."
                       Foreground="{x:Static theme:ShPalette.TextSecondary}"/>
            <local:CustomButton x:Name="RetryButton" Appearance="Accent" Glyph="&#xE72C;" d:Visibility="Collapsed"
                                Margin="0,20,0,0" HorizontalAlignment="Center"
                                Click="OnRetryClick"/>
        </StackPanel>
    </Grid>
</UserControl>
