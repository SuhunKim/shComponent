<!--
    CustomSubMenu : 2차 서브메뉴. 기본은 콘텐츠 상단 가로 탭(밑줄 표시), Orientation=Vertical 이면 세로 목록.
    WHY: 선택 로직은 CustomMenu와 같은 NavButtonHost를 쓰고, 이 파일은 "서브메뉴 모양"만 책임진다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않는다. 그래서 색 리소스(sh.*)의 기본값과
         자리표시 항목(SubMenu1 ~ SubMenu3)을 XAML에 직접 두었다. 런타임에는 생성자가 자리표시 항목을 지우고 색 리소스를 속성값으로 덮어쓴다.
-->
<UserControl x:Class="shComponent.CustomSubMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignWidth="600" d:DesignHeight="48">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/shComponent;component/Themes/ScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 서브메뉴 색/모양. 기본값(디자이너용)이며 런타임에는 코드비하인드(ApplyResources/ApplyOrientation)가 덮어쓴다. -->
            <x:Static x:Key="sh.Sub.Foreground" Member="theme:ShPalette.TextSecondary"/>
            <x:Static x:Key="sh.Sub.SelectedForeground" Member="theme:ShPalette.TextPrimary"/>
            <x:Static x:Key="sh.Sub.Hover" Member="theme:ShPalette.NavHover"/>
            <x:Static x:Key="sh.Sub.Accent" Member="theme:ShPalette.Accent"/>
            <x:Static x:Key="sh.Sub.ItemCornerRadius" Member="theme:ShPalette.ControlCornerRadius"/>
            <Visibility x:Key="sh.Sub.IndicatorH">Visible</Visibility>
            <Visibility x:Key="sh.Sub.IndicatorV">Collapsed</Visibility>

            <ControlTemplate x:Key="SubItemTemplate" TargetType="{x:Type ToggleButton}">
                <Grid Background="Transparent" SnapsToDevicePixels="True">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource sh.Sub.ItemCornerRadius}"/>
                    <ContentPresenter x:Name="Presenter" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Border x:Name="IndicatorH" Width="16" Height="3" CornerRadius="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                            Background="{DynamicResource sh.Sub.Accent}" Opacity="0"
                            Visibility="{DynamicResource sh.Sub.IndicatorH}"/>
                    <Border x:Name="IndicatorV" Width="3" Height="16" CornerRadius="1.5"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource sh.Sub.Accent}" Opacity="0"
                            Visibility="{DynamicResource sh.Sub.IndicatorV}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource sh.Sub.Hover}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="IndicatorH" Property="Opacity" Value="1"/>
                        <Setter TargetName="IndicatorV" Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Presenter" Property="Opacity" Value="0.75"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- WHY: 글자색은 ToggleButton 자체의 Foreground로 바꿔야 한다. 내용(TextBlock)의 상속은 논리 트리(ToggleButton)를
                      따라가므로 템플릿 내부 ContentPresenter에 색을 지정해도 적용되지 않는다.
                      또한 로컬 값은 트리거보다 우선하므로 코드에서 Foreground를 직접 넣지 않고 Style Setter + Trigger로 둔다. -->
            <Style x:Key="SubItemStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Template" Value="{StaticResource SubItemTemplate}"/>
                <Setter Property="Foreground" Value="{DynamicResource sh.Sub.Foreground}"/>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource sh.Sub.SelectedForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 디자이너 자리표시 항목 전용 스타일(코드비하인드 CreateItemButton과 같은 값). -->
            <Style x:Key="DesignItemStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource SubItemStyle}">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Padding" Value="12,0,12,1"/>
                <Setter Property="FontFamily" Value="{x:Static theme:ShPalette.TextFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" Focusable="False"
                  VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
        <StackPanel x:Name="ItemsHost" Orientation="Horizontal">
            <!-- 디자이너 자리표시 항목: 런타임에는 생성자가 지운다. -->
            <ToggleButton Style="{StaticResource DesignItemStyle}" IsChecked="True" Content="SubMenu1"/>
            <ToggleButton Style="{StaticResource DesignItemStyle}" Content="SubMenu2"/>
            <ToggleButton Style="{StaticResource DesignItemStyle}" Content="SubMenu3"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
