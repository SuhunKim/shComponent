<!--
    CustomSkeleton : 데이터 로딩 중 표시하는 스켈레톤 화면(빛이 지나가는 shimmer 애니메이션).
    WHY: 빈 화면이나 스피너 대신 "곧 나타날 화면의 윤곽"을 먼저 보여 주면 체감 대기 시간이 줄고,
         로딩 완료 시 레이아웃이 크게 튀지 않는다. 블록 구성은 코드비하인드에서 속성값에 맞춰 만든다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않는다. 그래서 기본값(ShowHeader=True, RowCount=4)과 같은
         모양의 자리표시 블록을 XAML에 직접 두었다. 런타임에는 코드비하인드(BuildBlocks)가 BlocksHost를 비우고 속성값대로 다시 만든다.
-->
<UserControl x:Class="shComponent.CustomSkeleton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="400"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <!-- 디자이너 자리표시 블록 전용(코드비하인드 CreateRow/CreateBlock과 같은 값). -->
        <SolidColorBrush x:Key="DesignBlock" Color="{x:Static theme:ShPalette.SkeletonBaseColor}"/>
        <Style x:Key="DesignRow" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
            <Setter Property="CornerRadius" Value="{x:Static theme:ShPalette.OverlayCornerRadius}"/>
            <Setter Property="Background" Value="{x:Static theme:ShPalette.CardBackground}"/>
            <Setter Property="BorderBrush" Value="{x:Static theme:ShPalette.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="BlocksHost">
        <!-- 디자이너 자리표시 블록: 런타임에는 BuildBlocks가 지우고 다시 만든다. -->
        <Border Width="220" Height="28" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,20" Background="{StaticResource DesignBlock}"/>
        <Border Style="{StaticResource DesignRow}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,16,0" Background="{StaticResource DesignBlock}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.55*"/><ColumnDefinition Width="0.45*"/></Grid.ColumnDefinitions>
                        <Border Height="12" CornerRadius="6" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.33*"/><ColumnDefinition Width="0.67*"/></Grid.ColumnDefinitions>
                        <Border Height="10" CornerRadius="5" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Width="64" Height="24" CornerRadius="12" Margin="16,0,0,0" Background="{StaticResource DesignBlock}"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource DesignRow}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,16,0" Background="{StaticResource DesignBlock}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="0.3*"/></Grid.ColumnDefinitions>
                        <Border Height="12" CornerRadius="6" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.42*"/><ColumnDefinition Width="0.58*"/></Grid.ColumnDefinitions>
                        <Border Height="10" CornerRadius="5" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Width="64" Height="24" CornerRadius="12" Margin="16,0,0,0" Background="{StaticResource DesignBlock}"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource DesignRow}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,16,0" Background="{StaticResource DesignBlock}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.45*"/><ColumnDefinition Width="0.55*"/></Grid.ColumnDefinitions>
                        <Border Height="12" CornerRadius="6" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.27*"/><ColumnDefinition Width="0.73*"/></Grid.ColumnDefinitions>
                        <Border Height="10" CornerRadius="5" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Width="64" Height="24" CornerRadius="12" Margin="16,0,0,0" Background="{StaticResource DesignBlock}"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource DesignRow}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,16,0" Background="{StaticResource DesignBlock}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.62*"/><ColumnDefinition Width="0.38*"/></Grid.ColumnDefinitions>
                        <Border Height="12" CornerRadius="6" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.372*"/><ColumnDefinition Width="0.628*"/></Grid.ColumnDefinitions>
                        <Border Height="10" CornerRadius="5" Background="{StaticResource DesignBlock}"/>
                    </Grid>
                </StackPanel>
                <Border Grid.Column="2" Width="64" Height="24" CornerRadius="12" Margin="16,0,0,0" Background="{StaticResource DesignBlock}"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
