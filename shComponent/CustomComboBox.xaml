<!--
    CustomComboBox : Windows 11 톤의 드롭다운(선택 전용, IsEditable 미지원).
    WHY(구조): 디자이너에서 열리도록 x:Class UserControl로 만들고, 안에 진짜 ComboBox 하나를 넣어(래핑) 항목/선택/팝업 동작을 그대로 쓴다.
         Items / SelectedIndex / SelectedItem / SelectionChanged 는 코드비하인드가 안쪽 ComboBox와 연결한다.
    드롭다운 팝업 안의 색(강조/hover/선택/배경)은 코드비하인드가 Resources 키(sh.Combo.*)에 직접 써 넣는다.
    → 팝업 내부에서 부모를 찾아가는 바인딩 없이, "DP 변경 → Resources 갱신" 흐름이 코드로 명확히 보인다.
    디자이너: VS 디자이너는 이 파일을 열 때 코드비하인드를 실행하지 않고 기본 UserControl로 그린다.
         그래서 바인딩마다 FallbackValue(= 런타임 기본값, 글자는 ComboBox1)를, 루트에 d:글꼴/색을 두어 디자이너에서도 실제 모양이 보이게 했다.
         런타임에는 부모 컨트롤을 항상 찾으므로 FallbackValue와 d: 값은 쓰이지 않는다.
-->
<UserControl x:Class="shComponent.CustomComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:shComponent"
             xmlns:theme="clr-namespace:shComponent.Theming"
             mc:Ignorable="d"
             d:Foreground="{x:Static theme:ShPalette.TextPrimary}"
             d:FontFamily="{x:Static theme:ShPalette.TextFont}"
             d:FontSize="{x:Static theme:ShPalette.BodyFontSize}"
             d:DesignHeight="32" d:DesignWidth="180">
    <UserControl.Resources>
        <!-- 드롭다운 팝업 색. 기본값(디자이너용)이며 런타임에는 코드비하인드가 속성값으로 덮어쓴다. -->
        <x:Static x:Key="sh.Combo.Accent" Member="theme:ShPalette.Accent"/>
        <x:Static x:Key="sh.Combo.ItemHover" Member="theme:ShPalette.NavHover"/>
        <x:Static x:Key="sh.Combo.ItemSelected" Member="theme:ShPalette.NavSelected"/>
        <x:Static x:Key="sh.Combo.PopupBackground" Member="theme:ShPalette.PopupBackground"/>

        <ItemsPanelTemplate x:Key="ItemsPanel">
            <!-- WHY: 항목이 수백 개여도 화면에 보이는 것만 만들도록 가상화. -->
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <Style x:Key="ItemContainerStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12,7,12,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Grid x:Name="Root" Margin="0,1" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Bd" CornerRadius="4" Background="Transparent"/>
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource sh.Combo.Accent}" Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource sh.Combo.ItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource sh.Combo.ItemSelected}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboTemplate" TargetType="{x:Type ComboBox}">
            <Grid x:Name="Root" SnapsToDevicePixels="True">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue={x:Static theme:ShPalette.ControlCornerRadius}}"/>

                <!-- WHY: 전체 영역을 덮는 투명 토글 버튼이 클릭을 받아 드롭다운을 연다(표시 요소는 히트 테스트 제외). -->
                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="ContentSite"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"/>
                    <TextBlock x:Name="Placeholder"
                               Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue=ComboBox1}"
                               Foreground="{x:Static theme:ShPalette.TextSecondary}"
                               VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock Grid.Column="1" Text="&#xE70D;" FontSize="10" Margin="12,0,0,0"
                               FontFamily="{x:Static theme:ShPalette.IconFont}"
                               Foreground="{x:Static theme:ShPalette.TextSecondary}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                       Placement="Bottom" HorizontalOffset="-8" VerticalOffset="-4"
                       PopupAnimation="Slide"
                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <!-- WHY: 그림자를 내용 Border와 분리. Effect를 내용에 직접 걸면 글자가 비트맵화되어 흐려진다. -->
                    <Grid Margin="8" MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border Background="{DynamicResource sh.Combo.PopupBackground}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.14"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DropDownBorder" Background="{DynamicResource sh.Combo.PopupBackground}"
                                BorderBrush="{x:Static theme:ShPalette.ControlBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="SelectedItem" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue={x:Static theme:ShPalette.ControlHover}}"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue={x:Static theme:ShPalette.ControlPressed}}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <ComboBox x:Name="Combo"
              Style="{x:Null}"
              Template="{StaticResource ComboTemplate}"
              ItemsPanel="{StaticResource ItemsPanel}"
              ItemContainerStyle="{StaticResource ItemContainerStyle}"
              FocusVisualStyle="{x:Static theme:ShFocusVisual.Rounded}"
              IsDropDownOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, Mode=TwoWay, FallbackValue=False}"
              MaxDropDownHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue=300}"
              DisplayMemberPath="{Binding DisplayMemberPath, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue=''}"
              SelectedValuePath="{Binding SelectedValuePath, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue=''}"
              Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue={x:Static theme:ShPalette.ControlBackground}}"
              BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue={x:Static theme:ShPalette.ControlBorder}}"
              BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue=1}"
              Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue='12,5,12,6'}"
              HorizontalContentAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type local:CustomComboBox}}, FallbackValue=Left}"/>
</UserControl>
