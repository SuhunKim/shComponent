<!--
    TemplatePage : 새 페이지를 만들 때 복사해서 시작하는 빈 템플릿.
    1) 이 파일 쌍을 복사해 이름 변경  2) MainWindow에서 PageFactory.Register<새페이지>("키")  3) 메뉴에 NavItem("키", ...) 추가
-->
<UserControl x:Class="shComponent.Demo.Pages.TemplatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="urn:shComponent">
    <StackPanel Margin="0,0,0,24">
        <sh:CustomGroupBox Header="Section1">
            <StackPanel>
                <TextBlock x:Name="InfoText" Foreground="#616161" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <sh:CustomButton x:Name="PrimaryButton" Content="Button1" Appearance="Accent" Click="OnPrimaryClick"/>
                    <sh:CustomButton Content="Button2" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </sh:CustomGroupBox>

        <TextBlock Text="Section2" FontWeight="SemiBold" Margin="2,20,0,8"/>
        <!-- 로딩된 데이터로 코드비하인드가 채운다 -->
        <StackPanel x:Name="ItemsHost"/>
    </StackPanel>
</UserControl>
