<UserControl x:Class="shComponent.Demo.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="urn:shComponent">
    <StackPanel Margin="0,0,0,24">
        <sh:CustomGroupBox Header="Appearance">
            <WrapPanel>
                <sh:CustomButton Content="Standard" Margin="0,0,8,8"/>
                <sh:CustomButton Content="Accent" Appearance="Accent" Margin="0,0,8,8"/>
                <sh:CustomButton Content="Subtle" Appearance="Subtle" Margin="0,0,8,8"/>
                <sh:CustomButton Content="비활성" IsEnabled="False" Margin="0,0,8,8"/>
                <sh:CustomButton Content="강조 비활성" Appearance="Accent" IsEnabled="False" Margin="0,0,8,8"/>
            </WrapPanel>
        </sh:CustomGroupBox>

        <sh:CustomGroupBox Header="아이콘" Margin="0,20,0,0">
            <WrapPanel>
                <sh:CustomButton Content="새로 만들기" Glyph="&#xE710;" Appearance="Accent" Margin="0,0,8,8"/>
                <sh:CustomButton Content="저장" Glyph="&#xE74E;" Margin="0,0,8,8"/>
                <sh:CustomButton Content="삭제" Glyph="&#xE74D;" Margin="0,0,8,8"/>
                <sh:CustomButton Glyph="&#xE713;" Appearance="Subtle" Width="36" Padding="0" ToolTip="설정" Margin="0,0,8,8"/>
                <sh:CustomButton Glyph="&#xE72C;" Appearance="Subtle" Width="36" Padding="0" ToolTip="새로 고침" Margin="0,0,8,8"/>
            </WrapPanel>
        </sh:CustomGroupBox>

        <sh:CustomGroupBox Header="속성으로 색/모양 변경" Margin="0,20,0,0">
            <WrapPanel>
                <sh:CustomButton Content="초록 강조" Appearance="Accent" AccentBrush="#0F7B0F" Margin="0,0,8,8"/>
                <sh:CustomButton Content="보라 강조" Appearance="Accent" AccentBrush="#8B45C6" Margin="0,0,8,8"/>
                <sh:CustomButton Content="알약 모양" CornerRadius="16" Padding="20,6" Margin="0,0,8,8"/>
                <sh:CustomButton Content="부드러운 파랑" Background="#E8F1FB" BorderBrush="#C7DDF5"
                                 HoverBackground="#DCEAF9" PressedBackground="#CFE2F6" Foreground="#004A8F" Margin="0,0,8,8"/>
            </WrapPanel>
        </sh:CustomGroupBox>
    </StackPanel>
</UserControl>
